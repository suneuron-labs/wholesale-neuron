# Database (Neon Postgres — Prisma reads only these two)
# DATABASE_URL = pooled Neon host (…-pooler…, sslmode=require)
# DIRECT_URL   = unpooled Neon host (migrations / pg_dump restore)
DATABASE_URL=
DIRECT_URL=

# Unused rollback copies of the previous Supabase URLs.
# To switch back: copy these into DATABASE_URL / DIRECT_URL and restart.
# Do not commit real values.
# SUPABASE_DATABASE_URL=
# SUPABASE_DIRECT_URL=

# Shopify app credentials (Partner Dashboard → App → Settings)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_discounts,write_validations,write_payment_customizations
SHOPIFY_APP_URL=https://wholesale-neuron.vercel.app

# Optional: custom shop domain for local auth quirks
# SHOP_CUSTOM_DOMAIN=

# Set to 1 in non-production to force the Shopify test charge approval flow
# ENFORCE_BILLING=1
